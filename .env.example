# ===========================================
# AgentHub — Environment Variables
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to git!

# ===========================================
# PUBLIC VARIABLES (Safe for frontend if prefixed)
# ===========================================
# Vite API URL for the frontend (optional for Vercel, defaults to /api)
VITE_API_URL=/api

# ===========================================
# SERVER ONLY SECRET VARIABLES (Do not expose!)
# ===========================================

# AI Provider (gemini | openai)
AI_PROVIDER=gemini
# Your Gemini API Key
AI_API_KEY=your_gemini_api_key_here

# Algorand Testnet Wallets
# PAYER: The wallet that pays for skills (user wallet)
# Get mnemonic from Pera Wallet or AlgoKit
PAYER_MNEMONIC=your_twenty_five_word_mnemonic_phrase_goes_here
PAYER_ADDRESS=YOUR_PAYER_WALLET_ADDRESS

# RECEIVER: The wallet that receives skill payments (provider wallet)
RECEIVER_ADDRESS=YOUR_RECEIVER_WALLET_ADDRESS

# USDC Testnet ASA ID (do not change for testnet)
USDC_ASA_ID=10458941

# x402 Facilitator
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Server Config (Used for local development)
API_PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
