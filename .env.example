# ===========================================
# PUBLIC VARIABLES (Frontend & Backend)
# ===========================================
# The URL of your deployed backend API (used by Frontend)
VITE_API_URL=https://your-api-url.vercel.app/api

# The URL of your deployed frontend (used by Backend for CORS)
FRONTEND_URL=https://your-frontend-url.vercel.app

# The URL of your deployed backend API (used by Backend for self-referencing)
API_URL=https://your-api-url.vercel.app

# USDC Testnet ASA ID (do not change for testnet)
USDC_ASA_ID=10458941

# x402 Facilitator
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Server Port (Local dev only)
API_PORT=3001

# ===========================================
# SERVER-ONLY SECRET VARIABLES (Backend Only)
# NEVER EXPOSE THESE TO THE BROWSER
# ===========================================

# AI Provider (gemini | openai)
AI_PROVIDER=gemini

# Your Gemini API Key
AI_API_KEY=your_gemini_api_key_here

# PAYER: The wallet that pays for skills (user wallet)
PAYER_MNEMONIC=your_25_word_mnemonic_phrase_here
PAYER_ADDRESS=YOUR_PAYER_WALLET_ADDRESS_HERE

# RECEIVER: The wallet that receives skill payments (provider wallet)
RECEIVER_ADDRESS=YOUR_RECEIVER_WALLET_ADDRESS_HERE
