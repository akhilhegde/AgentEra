# ===========================================
# AgentHub — Environment Variables
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to git!

# AI Provider (gemini | openai)
AI_PROVIDER=gemini
AI_API_KEY=your_api_key_here

# Algorand Testnet Wallets
# PAYER: The wallet that pays for skills (user wallet)
# Get mnemonic from Pera Wallet or AlgoKit
PAYER_MNEMONIC=your 25 word mnemonic goes here

# RECEIVER: The wallet that receives skill payments (provider wallet)
RECEIVER_ADDRESS=YOUR_RECEIVER_ALGORAND_ADDRESS_HERE

# USDC Testnet ASA ID (do not change for testnet)
USDC_ASA_ID=10458941

# x402 Facilitator
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Server
API_PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
