# ===================================================
# AgentEra / AgentHub — Production Environment Configuration
# ===================================================

# ---------------------------------------------------
# PUBLIC / FRONTEND VARIABLES (Exposed to browser)
# ---------------------------------------------------
# Base URL of the backend API (Leave empty for single Vercel project deployment)
VITE_API_URL=

# ---------------------------------------------------
# SERVER-ONLY SECRET VARIABLES (Keep confidential!)
# NEVER expose VITE_* prefixes for these variables!
# ---------------------------------------------------

# AI Provider Credentials
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here

# Algorand TestNet Network & Wallets
# PAYER: 25-word seed phrase for the server-side default payer wallet
PAYER_MNEMONIC=your_25_word_mnemonic_seed_phrase_here
PAYER_ADDRESS=your_algorand_payer_public_address_here

# RECEIVER: Public Algorand address that receives USDC skill payments
RECEIVER_ADDRESS=your_algorand_receiver_public_address_here

# USDC Testnet ASA ID (Default: 10458941 on Algorand TestNet)
USDC_ASA_ID=10458941

# x402 Facilitator Settlement Protocol URL
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Production Frontend Origin (used for backend CORS checks)
FRONTEND_URL=https://your-agentera-app.vercel.app

# Server Port (Local development only)
API_PORT=3001
