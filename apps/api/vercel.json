{
    "version": 2,
    "buildCommand": "echo \"No build required\"",
    "outputDirectory": "src",
    "builds": [
        {
            "src": "src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/index.ts"
        }
    ]
}
